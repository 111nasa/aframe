<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Initials VR</title>
 
  <script src="https://aframe.io/releases/1.7.1/aframe.min.js"></script>
</head>
 
<body>
  <a-scene>
    <a-sky color="#ECECEC"></a-sky>
 
    <a-plane
      position="0 0 -4"
      rotation="-90 0 0"
      width="6"
      height="6"
      color="#7BC8A4">
    </a-plane>
 
    <a-text
      value="SN"
      position="0 1.8 -3"
      align="center"
      color="#111111"
      width="6"
      scale="2 2 2">
    </a-text>
  </a-scene>
</body>
</html>

